[Unit]
Description=Transword Vocabulary Sync API
After=network.target

[Service]
Type=simple
User=transword
Group=transword
WorkingDirectory=/opt/transword
EnvironmentFile=/etc/transword-sync.env
ExecStart=/usr/bin/python3 /opt/transword/transword-sync.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/transword-sync

[Install]
WantedBy=multi-user.target
